# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=maritime_oilspill
POSTGRES_HOST=postgres
POSTGRES_PORT=5432


# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Per-service internal uvicorn port
PORT=8000

# AIS Live Feed
AIS_PROVIDER=aisstream
AISSTREAM_API_KEY=putkey
AIS_BBOX_MIN_LAT=14.0
AIS_BBOX_MIN_LON=68.0
AIS_BBOX_MAX_LAT=25.0
AIS_BBOX_MAX_LON=77.5

# AIS Analytics
WINDOW_MINUTES=15
PROXIMITY_RADIUS_M=1000

# Anomaly Detection
AIS_GAP_THRESHOLD_MINUTES=30
ERRATIC_COURSE_VARIANCE=2500
LOITERING_THRESHOLD=0.8

# STS Detection
STS_DISTANCE_THRESHOLD_M=500
STS_SPEED_THRESHOLD_KN=2.0
STS_MIN_DURATION_MIN=30

# Spoof Detection
MAX_PLAUSIBLE_AIS_ERROR_M=500
MAX_PHYSICAL_SPEED_MS=25.7

# Risk Engine
RISK_DECAY_RATE=0.05
RISK_TIER_MEDIUM=20
RISK_TIER_HIGH=50
RISK_TIER_CRITICAL=75

# Simulator
PLAYBACK_SPEED=60

# VesselAPI live feed (local secret; this .env file is git-ignored)
AIS_PROVIDER=vesselapi
VESSELAPI_API_KEY= putkey
VESSELAPI_BBOX_MIN_LAT=18.4
VESSELAPI_BBOX_MIN_LON=71.5
VESSELAPI_BBOX_MAX_LAT=19.8
VESSELAPI_BBOX_MAX_LON=73.0
VESSELAPI_POLL_INTERVAL_SECONDS=60

# Earth Engine (GEE) service-account credentials for SAR acquisition.
# The value is a SECRET — keep it in this git-ignored .env file only.
# The private key JSON is mounted read-only into the data-ingestion container
# at /run/secrets/gee-key.json (see docker-compose.yml); do NOT commit the key.
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_PATH=/run/secrets/gee-key.json