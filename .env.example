# PostgreSQL
POSTGRES_USER=aqua_sentinel
POSTGRES_PASSWORD=change_me
POSTGRES_DB=aqua_sentinel
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Per-service internal uvicorn port
PORT=8000

# Live vessel feed (aisstream or vesselapi)
AIS_PROVIDER=vesselapi
AISSTREAM_API_KEY=8b2b46c7433daad5830de215061d33ca1a792f1a
VESSELAPI_API_KEY=
# VesselAPI permits bounding boxes with a total lat/lon span of at most 4°.
# This compact region covers Mumbai harbor and nearby offshore traffic.
VESSELAPI_BBOX_MIN_LAT=18.4
VESSELAPI_BBOX_MIN_LON=71.5
VESSELAPI_BBOX_MAX_LAT=19.8
VESSELAPI_BBOX_MAX_LON=73.0
VESSELAPI_POLL_INTERVAL_SECONDS=60
AIS_BBOX_MIN_LAT=14.0
AIS_BBOX_MIN_LON=68.0
AIS_BBOX_MAX_LAT=25.0
AIS_BBOX_MAX_LON=77.5

# AIS Analytics
WINDOW_MINUTES=15
PROXIMITY_RADIUS_M=1000

# Anomaly Detection
AIS_GAP_THRESHOLD_MINUTES=30
ERRATIC_COURSE_VARIANCE=2500
LOITERING_THRESHOLD=0.8

# STS Detection
STS_DISTANCE_THRESHOLD_M=500
STS_SPEED_THRESHOLD_KN=2.0
STS_MIN_DURATION_MIN=30

# Spoof Detection
MAX_PLAUSIBLE_AIS_ERROR_M=500
MAX_PHYSICAL_SPEED_MS=25.7

# Risk Engine
RISK_DECAY_RATE=0.05
RISK_TIER_MEDIUM=20
RISK_TIER_HIGH=50
RISK_TIER_CRITICAL=75

# Simulator
PLAYBACK_SPEED=60
