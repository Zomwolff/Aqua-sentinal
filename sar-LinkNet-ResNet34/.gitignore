# Virtual environments
venv/
.venv/

# Large model weights — shared out-of-band (Drive/USB), not via git
checkpoints/
*.pth

# Dataset (large, local only)
dataset/

# Generated outputs (masks, overlays, demo runs, batch runs, B2 vectors)
outputs/
*.csv
sample_check.png
# NOTE: predictions_sample.png is intentionally tracked (referenced by evaluation_report.md)

# Trained classifier artifacts (rebuild with train_b2.py; too large/niche to track)
models/
*.joblib

# Raw/local datasets (recreate per machine; see README for sources)
data_raw_*.csv

# Logs / temp files
*.log
*.tmp
*~

# GDAL/QGIS sidecars (statistics, overviews) created when rasters are opened
*.aux.xml
*.ovr

# Coverage reports
.coverage
htmlcov/

# Python bytecode / caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# OS / editor clutter
.DS_Store
Thumbs.db
.idea/
.vscode/
